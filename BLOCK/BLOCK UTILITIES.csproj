<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AutoCADBlockTools</RootNamespace>
    <AssemblyName>BlockUtilities</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="23.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="23.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="DeployBundle" AfterTargets="Build">
    <MakeDir Directories="$(AppData)\Autodesk\ApplicationPlugins\BlockUtilities.bundle\Contents" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\BlockUtilities.bundle\Contents" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\BlockUtilities.bundle\Contents" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)\PackageContents.xml" DestinationFolder="$(AppData)\Autodesk\ApplicationPlugins\BlockUtilities.bundle" SkipUnchangedFiles="false" />
  </Target>

</Project>
