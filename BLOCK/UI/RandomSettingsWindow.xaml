<Window x:Class="AutoCADBlockTools.UI.RandomSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Random Settings" Height="280" Width="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ThemeDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="10,0,10,0">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Global Settings (RSET)" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="✕" Width="32" Height="26" Margin="0,0,6,0" Style="{StaticResource DangerButton}" Click="BtnCancel_Click" BorderThickness="0" Background="Transparent"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Margin="14,14,14,14" Padding="12">
                <StackPanel>
                    <TextBlock Text="Scale Parameters" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Min:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="txtMinScale" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="2" Text="Max:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" x:Name="txtMaxScale"/>
                    </Grid>

                    <TextBlock Text="Rotation Parameters" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Min:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="txtMinAngle" Margin="0,0,15,0"/>
                        <TextBlock Grid.Column="2" Text="Max:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" x:Name="txtMaxAngle"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom Bar -->
            <Border Grid.Row="2" Background="{StaticResource TitleBarBrush}" CornerRadius="0,0,10,10" Padding="14,0,14,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Style="{StaticResource DarkButton}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                    <Button Content="OK" Style="{StaticResource AccentButton}" Click="BtnOk_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
